#!/usr/bin/env python3
import copy
import json
import sys
import tempfile
import unittest
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from gpt_agent_adapter import GPTAgent, _rewrite_option_hits


class FakeResponse:
    def __init__(self, status_code, body):
        self.status_code = status_code
        self._body = body
        self.text = json.dumps(body)
        self.ok = 200 <= status_code < 300

    def json(self):
        return self._body

    def raise_for_status(self):
        if not self.ok:
            raise RuntimeError(f"HTTP {self.status_code}")


class SequenceSession:
    def __init__(self, responses):
        self.responses = list(responses)
        self.payloads = []

    def post(self, _url, *, headers, json, timeout):
        self.payloads.append(copy.deepcopy(json))
        return self.responses.pop(0)


class GPTAgentClientTest(unittest.TestCase):
    def test_decide_repairs_option_copy_and_aggregates_usage(self):
        agent = GPTAgent.__new__(GPTAgent)
        agent.max_evidence_images = 0
        agent.rewrite_repair_attempts = 1
        responses = iter(
            [
                {
                    "keep": [],
                    "drop": [],
                    "action": "REWRITE",
                    "rewrite_query": "检索小肠绒毛",
                    "reason": "证据不足",
                    "_api_meta": {
                        "usage": {"prompt_tokens": 10, "completion_tokens": 5, "total_tokens": 15, "cost": 0.01}
                    },
                },
                {
                    "keep": [99],
                    "drop": [],
                    "action": "ACCEPT",
                    "rewrite_query": "检索指状突起与蜂窝样微结构",
                    "reason": "不应覆盖",
                    "_api_meta": {
                        "usage": {"prompt_tokens": 8, "completion_tokens": 7, "total_tokens": 15, "cost": 0.02}
                    },
                },
            ]
        )
        agent._post_json = lambda _messages: next(responses)

        result = agent.decide(
            qid="q-repair",
            query_type="anatomical_site_recognition",
            original_query="这是什么部位？",
            question="这是什么部位？",
            options={"A": "食管", "B": "结肠", "C": "胃", "D": "小肠"},
            evidence=[],
        )

        self.assertTrue(result["validation"]["valid"])
        self.assertEqual(result["action"], "REWRITE")
        self.assertEqual(result["rewrite_query"], "检索指状突起与蜂窝样微结构")
        self.assertEqual(result["reason"], "证据不足")
        self.assertEqual(result["raw"]["_repair_audit"]["repair_count"], 1)
        self.assertEqual(result["raw"]["_api_meta"]["request_count"], 2)
        self.assertEqual(result["raw"]["_api_meta"]["aggregate_usage"]["total_tokens"], 30)
        self.assertAlmostEqual(result["raw"]["_api_meta"]["aggregate_usage"]["cost"], 0.03)

    def test_short_chinese_option_copy_is_detected(self):
        hits = _rewrite_option_hits(
            "检索胃窦与小肠绒毛的内镜差异",
            {"A": "食管", "B": "结肠", "C": "胃", "D": "小肠"},
        )
        self.assertEqual(hits, ["C", "D"])

    def test_openrouter_region_error_retries_without_response_format(self):
        agent = GPTAgent.__new__(GPTAgent)
        agent.model = "openai/gpt-5.4"
        agent.base_url = "https://openrouter.ai/api/v1"
        agent.api_key = "test-key"
        agent.timeout = 30
        agent.max_tokens = 400
        agent.temperature = 0.2
        agent.top_p = 0.9
        agent.trust_env = True
        agent.reasoning = {}
        agent.session = SequenceSession(
            [
                FakeResponse(
                    403,
                    {
                        "error": {
                            "message": "This model is not available in your region.",
                            "code": 403,
                        }
                    },
                ),
                FakeResponse(
                    200,
                    {
                        "model": "openai/gpt-5.4",
                        "choices": [{"message": {"content": '{"action":"ACCEPT"}'}}],
                        "usage": {"total_tokens": 42},
                    },
                ),
            ]
        )

        result = agent._post_json([{"role": "user", "content": "test"}])

        self.assertEqual(len(agent.session.payloads), 2)
        self.assertIn("response_format", agent.session.payloads[0])
        self.assertNotIn("response_format", agent.session.payloads[1])
        self.assertEqual(
            result["_api_meta"]["response_format_fallback"],
            "http_403_region_route",
        )
        self.assertTrue(result["_api_meta"]["trust_env"])

    def test_transient_524_is_retried_and_audited(self):
        agent = GPTAgent.__new__(GPTAgent)
        agent.model = "gpt-5.4"
        agent.base_url = "https://api.ikuncode.cc/v1"
        agent.api_key = "test-key"
        agent.timeout = 30
        agent.max_retries = 1
        agent.retry_backoff_s = 0.0
        agent.max_tokens = 400
        agent.temperature = 0.6
        agent.top_p = 0.95
        agent.trust_env = True
        agent.reasoning = {}
        agent.session = SequenceSession(
            [
                FakeResponse(
                    524,
                    {"error": {"message": "upstream timeout"}},
                ),
                FakeResponse(
                    200,
                    {
                        "model": "gpt-5.4",
                        "choices": [{"message": {"content": '{"action":"ACCEPT"}'}}],
                        "usage": {"total_tokens": 42},
                    },
                ),
            ]
        )

        result = agent._post_json([{"role": "user", "content": "test"}])

        self.assertEqual(len(agent.session.payloads), 2)
        self.assertEqual(result["_api_meta"]["transport_retry_count"], 1)
        self.assertEqual(result["_api_meta"]["transport_attempt_count"], 2)

    def test_reasoning_payload_omits_sampling_parameters(self):
        agent = GPTAgent.__new__(GPTAgent)
        agent.model = "openai/gpt-5.6-sol"
        agent.base_url = "https://openrouter.ai/api/v1"
        agent.api_key = "test-key"
        agent.timeout = 30
        agent.max_tokens = 2048
        agent.temperature = 0.6
        agent.top_p = 0.95
        agent.trust_env = True
        agent.reasoning = {"effort": "max", "exclude": True}
        agent.session = SequenceSession(
            [
                FakeResponse(
                    200,
                    {
                        "model": "openai/gpt-5.6-sol",
                        "choices": [{"message": {"content": '{"action":"ACCEPT"}'}}],
                        "usage": {"total_tokens": 42},
                    },
                )
            ]
        )

        result = agent._post_json([{"role": "user", "content": "test"}])

        payload = agent.session.payloads[0]
        self.assertEqual(payload["reasoning"]["effort"], "max")
        self.assertNotIn("temperature", payload)
        self.assertNotIn("top_p", payload)
        self.assertEqual(result["_api_meta"]["reasoning"]["effort"], "max")

    def test_config_can_enable_environment_proxy(self):
        with tempfile.TemporaryDirectory() as tmpdir:
            config_path = Path(tmpdir) / "api.json"
            config_path.write_text(
                json.dumps(
                    {
                        "model": "openai/gpt-5.4",
                        "base_url": "https://openrouter.ai/api/v1",
                        "api_key": "test-key",
                        "trust_env": True,
                    }
                ),
                encoding="utf-8",
            )
            agent = GPTAgent(api_config_path=str(config_path))

        self.assertTrue(agent.trust_env)
        self.assertTrue(agent.session.trust_env)

    def test_config_controls_timeout_when_not_explicitly_overridden(self):
        with tempfile.TemporaryDirectory() as tmpdir:
            config_path = Path(tmpdir) / "api.json"
            config_path.write_text(
                json.dumps(
                    {
                        "model": "gpt-5.4",
                        "base_url": "https://example.invalid/v1",
                        "api_key": "test-key",
                        "timeout": 300,
                        "max_retries": 4,
                        "retry_backoff_s": 3.0,
                    }
                ),
                encoding="utf-8",
            )
            configured = GPTAgent(api_config_path=str(config_path))
            overridden = GPTAgent(api_config_path=str(config_path), timeout=45)

        self.assertEqual(configured.timeout, 300)
        self.assertEqual(overridden.timeout, 45)


if __name__ == "__main__":
    unittest.main()
