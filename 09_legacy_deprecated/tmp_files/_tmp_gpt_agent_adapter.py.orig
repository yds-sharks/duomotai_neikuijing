#!/usr/bin/env python3
"""v0.3 agent policy adapter (GPT rollout / inference).

单 policy 一次输出 keep/drop + ACCEPT/REWRITE(+rewrite_query)。
没有中间 reranker：检索结果直接喂给 policy，policy 直接看像素做逐条价值判断。

输出 schema（与设计文档 §3.2 对齐）：
  {"keep": [0, 2, 4], "drop": [1, 3], "action": "ACCEPT"}
  {"keep": [0], "drop": [1,2,3,4], "action": "REWRITE", "rewrite_query": "..."}
"""

from __future__ import annotations

import json
import re
import time
from pathlib import Path
from typing import Any, Dict, List, Optional

import requests

from generator_adapter import candidate_chat_urls, image_to_data_uri
from rag_prompting import format_evidence

CODE_DIR = Path(__file__).resolve().parent
AGENTIC_ROOT = CODE_DIR.parent
DEFAULT_API_CONFIG = str(AGENTIC_ROOT / "data_construction" / "api_config.local.json")

SYSTEM_PROMPT = """你是医学多模态 RAG 的 agentic 证据控制器。

给定问题、选项、原始低信息 query、query image 和当前候选证据（每条带 modality/文本/图片/初检分数），
你需要做两件事，**在一次 JSON 输出里完成**：

1. **keep/drop 逐条价值判断**：对每条检索证据，判断它对回答当前问题是有价值（keep）还是误导/无用（drop）。
   关键：医学图像里"视觉相似 ≠ 临床相同"，同部位不同病理经常高度相似。你要能 drop 掉那些"看起来像、
   但临床逻辑/证据文本指向另一个诊断"的高置信误导证据。
   对病变题，部位相同不等于病变相同；分期、形态、颜色、表面覆盖物、血管和空间位置等判别特征优先于部位。
   证据控制首先追求召回：只要一条证据与 query image 和某个合理候选在关键特征上相符，就应暂时 keep。
   不得为了让证据看起来一致而删除仍然合理的竞争证据，也不得仅凭表面相似度把证据压缩到单一诊断。
   kept 证据若仍支持互相竞争的解释，就不能 ACCEPT；保留这些合理证据并 REWRITE 获取区分性信息。

2. **ACCEPT/REWRITE 决策**：
   - 只有当 kept 证据整体提供了充分、互相印证的判别信息，且不存在被误删的合理竞争证据时，
     才能 action="ACCEPT"。
   - 如果 kept 证据不足、歧义、或明显缺少关键判别信息 → action="REWRITE"，并给出更精准的
     rewrite_query 用于下一轮重检索。

约束：
- rewrite_query 不能包含答案字母（A/B/C/D）。
- rewrite_query 不能直接说"正确答案是..."或泄露 gold answer。
- rewrite_query 不能逐字复制任一完整选项；只能使用从图像和证据中独立观察到的判别特征。
- rewrite_query 不得枚举候选部位、疾病、操作或方位；即使同时列出多个选项实体，也属于选项泄漏。
- 输出前逐项检查 rewrite_query：不得包含任何选项值的原文，包括“胃”这类单字中文选项；必须改写为形态描述。
- rewrite_query 应注入判别性临床词、视觉特征、部位或选项区分信息。
- 不要生成最终答案，只做证据取舍和检索策略决策。
- 不确定时优先保留 2--6 条互补或竞争证据并 REWRITE，不要过度自信地只保留一条后 ACCEPT。
- 证据索引从 0 开始，必须严格使用题面中显示的索引。
- 只输出 JSON，不输出解释性正文。
"""

USER_TEMPLATE = """请基于 query image 和当前检索证据，做 keep/drop + ACCEPT/REWRITE 决策。

qid: {qid}
query_type: {query_type}
初始低信息 query: {original_query}
当前检索 query: {current_query}
当前轮次: {round_index}/{max_rounds}
问题: {question}
选项: {options}

当前候选证据（{num_evidence} 条，按检索顺序从 0 编号）：
{evidence_block}

若某条证据包含图像，其像素会在下方以“候选证据图像 [idx]”标记后附加。

请严格输出 JSON：
{{
  "keep": [idx_1, idx_2, ...],
  "drop": [idx_1, idx_2, ...],
  "action": "ACCEPT" 或 "REWRITE",
  "rewrite_query": "仅当 action=REWRITE 时填写，否则空字符串",
  "reason": "不超过 100 字，说明 kept 证据是否足够作答，或为什么需要改写"
}}

注意：keep 与 drop 索引必须覆盖全部 {num_evidence} 条证据，且不能重叠。
若选择 REWRITE，rewrite_query 只能写可观察的视觉/临床判别特征，不得出现上方任一选项值的原文。
"""

REPAIR_SYSTEM_PROMPT = """你是检索 query 的防泄漏校验器。
上一次 Agent 决策中的 rewrite_query 原样包含了题目选项文本。保持 keep、drop、action 和 reason 不变，
只把 rewrite_query 改写为不含任何选项原文的视觉或临床形态描述。不要枚举候选答案，不要新增诊断结论。
只输出与原 schema 相同的 JSON。"""


def load_api_config(path: str = DEFAULT_API_CONFIG) -> Dict[str, Any]:
    data = json.loads(Path(path).read_text(encoding="utf-8"))
    return data


def _parse_keep_drop(data: Dict[str, Any], num_evidence: int) -> Dict[str, Any]:
    """Validate coverage and return repaired indices plus explicit audit metadata."""
    raw_keep = data.get("keep")
    raw_drop = data.get("drop")
    repairs: List[str] = []
    if not isinstance(raw_keep, list):
        raw_keep = []
        repairs.append("keep_not_list")
    if not isinstance(raw_drop, list):
        raw_drop = []
        repairs.append("drop_not_list")

    def parse_indices(values: List[Any], field: str) -> List[int]:
        parsed: List[int] = []
        for value in values:
            text = str(value).strip()
            if not text.isdigit():
                repairs.append(f"{field}_non_integer")
                continue
            idx = int(text)
            if not 0 <= idx < num_evidence:
                repairs.append(f"{field}_out_of_range")
                continue
            parsed.append(idx)
        if len(parsed) != len(set(parsed)):
            repairs.append(f"{field}_duplicate")
        return sorted(set(parsed))

    keep = parse_indices(raw_keep, "keep")
    drop = parse_indices(raw_drop, "drop")
    keep_set = set(keep)
    overlap = keep_set & set(drop)
    if overlap:
        repairs.append("keep_drop_overlap")
        drop = [idx for idx in drop if idx not in overlap]

    covered = keep_set | set(drop)
    missing = [idx for idx in range(num_evidence) if idx not in covered]
    if missing:
        repairs.append("incomplete_coverage")
        drop.extend(missing)
    drop = sorted(set(drop))
    return {
        "keep": keep,
        "drop": drop,
        "validation": {
            "valid": not repairs,
            "repairs": sorted(set(repairs)),
            "missing_indices": missing,
            "overlap_indices": sorted(overlap),
            "num_evidence": int(num_evidence),
        },
    }


def _rewrite_option_hits(query: str, options: Dict[str, Any]) -> List[str]:
    compact_query = re.sub(r"\s+", "", str(query or "")).lower()
    hits: List[str] = []
    for letter, value in options.items():
        compact_value = re.sub(r"\s+", "", str(value or "")).lower()
        if not compact_value:
            continue
        has_cjk = bool(re.search(r"[\u4e00-\u9fff]", compact_value))
        if (has_cjk or len(compact_value) >= 3) and compact_value in compact_query:
            hits.append(str(letter).strip().upper())
    return sorted(set(hits))


def _aggregate_api_usage(attempts: List[Dict[str, Any]]) -> Dict[str, Any]:
    usage_rows = [
        dict((item.get("_api_meta") or {}).get("usage") or {}) for item in attempts
    ]
    aggregate: Dict[str, Any] = {}
    for key in ("prompt_tokens", "completion_tokens", "total_tokens", "cost"):
        values = [row.get(key) for row in usage_rows if row.get(key) is not None]
        if values:
            aggregate[key] = sum(float(value) for value in values)
            if key != "cost":
                aggregate[key] = int(aggregate[key])
    return aggregate


class GPTAgent:
    """v0.3 GPT agent：一次输出 keep/drop + ACCEPT/REWRITE。"""

    def __init__(
        self,
        *,
        api_config_path: str = DEFAULT_API_CONFIG,
        model: Optional[str] = None,
        base_url: Optional[str] = None,
        api_key: Optional[str] = None,
        timeout: Optional[int] = None,
        max_retries: Optional[int] = None,
        retry_backoff_s: Optional[float] = None,
        max_tokens: Optional[int] = None,
        max_evidence_images: int = 20,
        temperature: float = 0.6,
        top_p: float = 0.95,
        trust_env: Optional[bool] = None,
        rewrite_repair_attempts: int = 1,
        reasoning: Optional[Dict[str, Any]] = None,
    ):
        cfg = load_api_config(api_config_path)
        self.model = model or cfg.get("model")
        self.base_url = base_url or cfg.get("base_url")
        self.api_key = api_key or cfg.get("api_key")
        self.timeout = int(
            cfg.get("timeout", 120) if timeout is None else timeout
        )
        self.max_tokens = int(
            cfg.get("max_tokens", 400) if max_tokens is None else max_tokens
        )
        self.max_evidence_images = int(max_evidence_images)
        self.temperature = float(temperature)
        self.top_p = float(top_p)
        self.trust_env = bool(
            cfg.get("trust_env", False) if trust_env is None else trust_env
        )
        self.rewrite_repair_attempts = max(int(rewrite_repair_attempts), 0)
        self.reasoning = dict(
            cfg.get("reasoning") or {} if reasoning is None else reasoning
        )
        if not self.api_key:
            raise ValueError("Missing API key for GPTAgent")
        if not self.base_url:
            raise ValueError("Missing base_url for GPTAgent")
        if not self.model:
            raise ValueError("Missing model for GPTAgent")
        self.session = requests.Session()
        self.session.trust_env = self.trust_env

    def _post_json(self, messages: List[Dict[str, Any]]) -> Dict[str, Any]:
        payload = {
            "model": self.model,
            "messages": messages,
            "max_tokens": self.max_tokens,
            "response_format": {"type": "json_object"},
        }
        if self.reasoning:
            payload["reasoning"] = self.reasoning
        else:
            payload["temperature"] = self.temperature
            payload["top_p"] = self.top_p
        headers = {"Authorization": f"Bearer {self.api_key}", "Content-Type": "application/json"}
        errors: List[str] = []
        for url in candidate_chat_urls(self.base_url):
            try:
                response_format_fallback = ""
                resp = self.session.post(url, headers=headers, json=payload, timeout=self.timeout)
                region_route_error = (
                    resp.status_code == 403
                    and "not available in your region" in resp.text.lower()
                )
                if (
                    resp.status_code in {400, 404, 405} or region_route_error
                ) and "response_format" in payload:
                    payload2 = dict(payload)
                    payload2.pop("response_format", None)
                    response_format_fallback = (
                        "http_403_region_route"
                        if region_route_error
                        else f"http_{resp.status_code}"
                    )
                    resp = self.session.post(url, headers=headers, json=payload2, timeout=self.timeout)
                if resp.status_code in {404, 405}:
                    errors.append(f"{url}: {resp.status_code} {resp.text[:200]}")
                    continue
                if not resp.ok:
                    errors.append(f"{url}: {resp.status_code} {resp.text[:500]}")
                    continue
                resp.raise_for_status()
                response_data = resp.json()
                content = response_data["choices"][0]["message"].get("content") or "{}"
                parse_mode = "json"
                try:
                    parsed = json.loads(content)
                except json.JSONDecodeError:
                    start = content.find("{")
                    end = content.rfind("}")
                    if start < 0 or end <= start:
                        raise
                    parsed = json.loads(content[start : end + 1])
                    parse_mode = "extracted_json"
                if not isinstance(parsed, dict):
                    raise ValueError("GPT agent response JSON must be an object")
                parsed["_api_meta"] = {
                    "requested_model": self.model,
                    "response_model": response_data.get("model"),
                    "usage": response_data.get("usage") or {},
                    "parse_mode": parse_mode,
                    "response_format_fallback": response_format_fallback,
                    "trust_env": self.trust_env,
                    "reasoning": self.reasoning,
                }
                return parsed
            except Exception as exc:
                errors.append(f"{url}: {type(exc).__name__}: {exc}")
        raise RuntimeError("GPT agent request failed: " + " | ".join(errors[-3:]))

    def decide(
        self,
        *,
        qid: str,
        query_type: str,
        original_query: str,
        question: str,
        options: Dict[str, Any],
        evidence: List[Dict[str, Any]],
        image_path: str = "",
        current_query: str = "",
        round_index: int = 1,
        max_rounds: int = 2,
    ) -> Dict[str, Any]:
        num_evidence = len(evidence)
        user_text = USER_TEMPLATE.format(
            qid=qid,
            query_type=query_type,
            original_query=original_query,
            current_query=current_query or original_query,
            round_index=int(round_index),
            max_rounds=int(max_rounds),
            question=question,
            options=json.dumps(options, ensure_ascii=False),
            num_evidence=num_evidence,
            evidence_block=format_evidence(evidence, max_chars_per_doc=700),
        )
        content: List[Dict[str, Any]] = [{"type": "text", "text": user_text}]
        image_uri = image_to_data_uri(image_path, max_edge=1024, quality=85, max_bytes=4_000_000)
        if image_uri:
            content.append({"type": "text", "text": "查询图像："})
            content.append({"type": "image_url", "image_url": {"url": image_uri}})
        attached = 0
        for idx, item in enumerate(evidence):
            if attached >= self.max_evidence_images:
                break
            evidence_image = str(item.get("image_path") or "")
            evidence_uri = image_to_data_uri(
                evidence_image,
                max_edge=768,
                quality=80,
                max_bytes=2_000_000,
            )
            if not evidence_uri:
                continue
            content.append({"type": "text", "text": f"候选证据图像 [{idx}]："})
            content.append({"type": "image_url", "image_url": {"url": evidence_uri}})
            attached += 1
        messages = [
            {"role": "system", "content": SYSTEM_PROMPT},
            {"role": "user", "content": content},
        ]
        data = self._post_json(messages)
        attempts = [data]
        initial_decision = {
            key: data.get(key) for key in ("keep", "drop", "action", "reason")
        }
        for _ in range(self.rewrite_repair_attempts):
            action_for_repair = str(data.get("action") or "").upper()
            rewrite_for_repair = str(data.get("rewrite_query") or "").strip()
            option_hits = (
                _rewrite_option_hits(rewrite_for_repair, options)
                if action_for_repair == "REWRITE"
                else []
            )
            if not option_hits:
                break
            repair_input = {
                "previous_decision": {
                    key: value for key, value in data.items() if not key.startswith("_")
                },
                "prohibited_option_values": [
                    str(options[letter]) for letter in option_hits if letter in options
                ],
                "instruction": "只改写 rewrite_query，去除所有选项原文。",
            }
            repaired = self._post_json(
                [
                    {"role": "system", "content": REPAIR_SYSTEM_PROMPT},
                    {
                        "role": "user",
                        "content": json.dumps(repair_input, ensure_ascii=False),
                    },
                ]
            )
            for key, value in initial_decision.items():
                repaired[key] = value
            data = repaired
            attempts.append(data)

        repair_attempts = []
        for index, item in enumerate(attempts):
            item_action = str(item.get("action") or "").upper()
            item_rewrite = str(item.get("rewrite_query") or "").strip()
            repair_attempts.append(
                {
                    "attempt_index": index,
                    "action": item_action,
                    "rewrite_query": item_rewrite,
                    "option_hits": (
                        _rewrite_option_hits(item_rewrite, options)
                        if item_action == "REWRITE"
                        else []
                    ),
                    "api_meta": dict(item.get("_api_meta") or {}),
                }
            )
        final_meta = dict(data.get("_api_meta") or {})
        final_meta["request_count"] = len(attempts)
        final_meta["aggregate_usage"] = _aggregate_api_usage(attempts)
        data["_api_meta"] = final_meta
        data["_repair_audit"] = {
            "repair_count": len(attempts) - 1,
            "attempts": repair_attempts,
        }

        kd = _parse_keep_drop(data, num_evidence)
        validation = dict(kd["validation"])
        repairs = list(validation.get("repairs") or [])
        requested_action = str(data.get("action") or "").upper()
        action = requested_action
        if action not in {"ACCEPT", "REWRITE"}:
            repairs.append("invalid_action")
            action = "ACCEPT"
        rewrite_query = str(data.get("rewrite_query") or "").strip()
        if action == "REWRITE" and not rewrite_query:
            repairs.append("empty_rewrite_query")
        rewrite_option_hits = (
            _rewrite_option_hits(rewrite_query, options)
            if action == "REWRITE" and rewrite_query
            else []
        )
        if rewrite_option_hits:
            repairs.append("rewrite_copies_option_text")
        if action == "ACCEPT":
            rewrite_query = ""
        validation["repairs"] = sorted(set(repairs))
        validation["valid"] = not validation["repairs"]
        validation["requested_action"] = requested_action
        validation["rewrite_option_hits"] = rewrite_option_hits
        return {
            "keep": kd["keep"],
            "drop": kd["drop"],
            "action": action,
            "rewrite_query": rewrite_query,
            "reason": str(data.get("reason") or "")[:200],
            "validation": validation,
            "raw": data,
        }


# 兼容旧名（smoke 脚本引用）
GPTRewriteAgent = GPTAgent
